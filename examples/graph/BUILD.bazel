load("//vhdl:defs.bzl", "vhdl_graph", "vhdl_library", "vhdl_module")

# Common VHDL package library
vhdl_library(
    name = "common",
    srcs = ["vhdl/common_pkg.vhd"],
    library_name = "common_lib",
)

# Counter module
vhdl_module(
    name = "counter",
    entity_name = "counter",
    generics = {
        "WIDTH": "8",
    },
    srcs = ["vhdl/counter.vhd"],
    deps = [":common"],
)

# Register file module
vhdl_module(
    name = "reg_file",
    entity_name = "reg_file",
    generics = {
        "DEPTH": "16",
        "WIDTH": "8",
    },
    srcs = ["vhdl/reg_file.vhd"],
    deps = [":common"],
)

# Top-level entity integrating modules with extra constraints data
vhdl_module(
    name = "top",
    entity_name = "top",
    srcs = ["vhdl/top.vhd"],
    data = ["data/constraints.xdc"],
    deps = [
        ":counter",
        ":reg_file",
    ],
)

# VHDL dependency graph (modules & libraries)
vhdl_graph(
    name = "design_graph",
    deps = [":top"],
)

# VHDL dependency graph including source and data files
vhdl_graph(
    name = "design_graph_with_files",
    deps = [":top"],
    include_files = True,
)
